# Normal-LLM lane (OpenAI chat completions, structured JSON output)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenRouter instead of OpenAI: OPENAI_BASE_URL=https://openrouter.ai/api/v1, OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Jev lane (TypeSafe System One)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# CLM lane: URL printed by `modal deploy deploy/modal_clm.py` (or your Kaggle tunnel)
CLM_BASE_URL=
CLM_API_KEY=
CLM_MODEL=clm-latest
